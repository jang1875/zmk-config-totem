#define MTGAP 0
#define QWERTY 1
#define NAV 2
#define NUM 3
#define FUNC 4
#define NOTHING 5

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <NAV NUM>;
            then-layer = <FUNC>;
        };
    };

    behaviors {
        ht: holdtap_tappreffered {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <11 12>;
        };

        ctlV {
            bindings = <&kp LC(V)>;
            key-positions = <12 13>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        gibon {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Y    |  P      |  O      |  U      |  J  |   |  K  |  D      |  L      |  C      |  W      | BKSP |
            // | CTRL | gui(I)|  sft(N) |  ctl(E) |  alt(A) |  .  |   |  M  |  alt(H) |  ctl(T) |  sft(S) |  gui(R) |  '   |
            // | SHFT |  Q    |  Z      |  ;      |  ,      |  '  |   |  B  |  F      |  G      |  V      |  X      | ESC  |
            //                          | bksp    | NUM     | SPC |   | ENT | RSE     | ALT     |

            bindings = <
               &kp Q  &kp W  &kp E        &kp R                  &kp T            &kp Y        &kp U        &kp I      &kp O    &kp P
               &kp A  &kp S  &kp D        &kp F                  &kp G            &kp H        &kp J        &kp K      &kp L    &kp SLASH
&kp BACKSPACE  &kp Z  &kp X  &kp C        &ht LA(F4) V           &ht LC(F10) B    &kp N        &kp M        &kp COMMA  &kp DOT  &kp DEL    &kp RIGHT_ALT
                             &kp LA(TAB)  &ht RIGHT_SHIFT ENTER  &lt 2 ENTER      &lt 3 SPACE  &lt 1 SPACE  &kp ESC
            >;
        };

        f {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q    |  W      |  E      |  R      |  T  |   |  Y  |  U      |  I      |  O      |  P      | BKSP |
            // | CTRL | gui(A)|  sft(S) |  ctl(D) |  alt(F) |  G  |   |  H  |  alt(J) |  ctl(K) |  sft(L) |  gui(;) |  '   |
            // | SHFT |  Z    |  X      |  C      |  V      |  B  |   |  N  |  M      |  ,      |  .      |  /      | ESC  |
            //                          | GUI     | LWR     | SPC |   | ENT | RSE     | ALT     |

            bindings = <
          &kp F1  &kp F2  &kp F3     &kp F4                &kp F5       &kp Y      &kp A           &kp UP_ARROW  &kp DEL    &kp HOME
          &kp F6  &kp F7  &kp F8     &kp F9                &kp F10      &kp H      &kp LEFT_ARROW  &kp DOWN      &kp RIGHT  &kp END
&kp CAPS  &kp Z   &kp X   &kp C      &kp V                 &kp B        &kp N      &kp M           &kp COMMA     &kp DOT    &kp PAGE_DOWN  &kp PAGE_UP
                          &kp SPACE  &ht LEFT_SHIFT ENTER  &kp ENTER    &kp SPACE  &mo NAV         &kp DEL
            >;
        };

        number {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  `  |     |  up |     |     |   |     |        | PGUP   | RALT  |     | BKSP |
            // | BTCLR| TAB | left| down|right|     |   |     |LA(HOME)|LC(PGDN)|LS(END)|     |      |
            // | SHFT | ESC |MTGAP|QWERT|     |     |   |     |G(left) |G(UP)   |G(RIGH)|CAPS |      |
            //                    |     |     |     |   |     |        |        |

            bindings = <
       &kp LC(NUMBER_1)  &kp LC(NUMBER_1)  &kp LC(NUMBER_2)  &kp LC(NUMBER_3)  &kp LC(NUMBER_4)    &kp EQUAL     &kp N7        &kp N8        &kp N9        &kp PLUS
       &kp LA(TAB)       &kp LA(TAB)       &kp LC(W)         &kp LC(F10)       &trans              &kp EQUAL     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS
&kp Z  &kp ESC           &kp X             &to QWERTY        &trans            &trans              &kp CAPSLOCK  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ASTERISK  &kp SLASH
                                           &bt BT_SEL 1      &bt BT_SEL 0      &kp ENTER           &trans        &trans        &kp N0
            >;
        };

        number_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  +  |  -  |  *  |  /  |  %  |   |  \  |  (  |  )  |  [  |  ]  | BKSP |
            // | CTRL |LG(1)|LS(2)|LC(3)|LA(4)|  5  |   |  6  |LA(7)|LC(8)|LS(9)|LG(0)|  `   |
            // | SHFT |  !  |  ~  |  ;  |  &  |  '  |   |  =  |  <  |  >  |  {  |  }  |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
              &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp SLASH    &kp PRCNT    &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
              &ht LGUI N1      &ht LSHFT N2  &ht LCTRL N3  &ht LALT N4  &kp N5       &kp N6     &ht LALT N7    &ht LCTRL N8  &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&bt BT_SEL 0  &bt BT_SEL 1     &kp TILDE     &kp SEMI      &kp AMPS     &kp SQT      &kp EQUAL  &kp LT         &kp GT        &kp LBRC              &bt BT_SEL 3           &bt BT_SEL 2
                                             &trans        &trans       &trans       &trans     &trans         &trans
            >;
        };

        function_layer {
            // -----------------------------------------------------------------------------------------
            // |      | BT1 | BT2 | BT3 |     |MSCDN|   |     |mkpL |mmvUP|mkpR | F12 |      |
            // |      |BTCLR|     |VOLDN|VOLUP|MSCUP|   |A(F4)|mmvLE|mmvDN|mmvRI| F11 |      |
            // |      | F1  | F2  | F3  | F4  | F5  |   | F6  | F7  | F8  | F9  | F10 |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans        &msc SCRL_UP      &trans      &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &kp F12
       &bt BT_CLR    &trans        &kp C_VOL_DN  &kp C_VOL_UP  &msc SCRL_DOWN    &kp LA(F4)  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp F11
&kp Z  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5            &kp F6      &kp F7          &kp F8          &kp F9           &kp F10  &kp ESC
                                   &trans        &trans        &trans            &trans      &trans          &trans
            >;
        };
    };
};
