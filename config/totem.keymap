#define MTGAP 0
#define QWERTY 1
#define NAV 2
#define NUM 3
#define FUNC 4
#define NOTHING 5

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <NAV NUM>;
            then-layer = <FUNC>;
        };
    };

    behaviors {
        ht: holdtap_tappreffered {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        g1 {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <2 1>;
        };

        g2 {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <3 2>;
        };

        wave {
            bindings = <&kp TILDE>;
            key-positions = <10 11>;
        };

        d1 {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <21 22>;
        };

        d2 {
            bindings = <&kt RIGHT_BRACKET>;
            key-positions = <22 23>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        gibon {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Y    |  P      |  O      |  U      |  J  |   |  K  |  D      |  L      |  C      |  W      | BKSP |
            // | CTRL | gui(I)|  sft(N) |  ctl(E) |  alt(A) |  .  |   |  M  |  alt(H) |  ctl(T) |  sft(S) |  gui(R) |  '   |
            // | SHFT |  Q    |  Z      |  ;      |  ,      |  '  |   |  B  |  F      |  G      |  V      |  X      | ESC  |
            //                          | bksp    | NUM     | SPC |   | ENT | RSE     | ALT     |

            bindings = <
                      &kp Y       &kp W           &kp E         &kp R             &kp T          &kp Y        &kp U              &kp I        &kp O            &kp P
                      &ht LGUI A  &ht LEFT_ALT S  &ht LCTRL D   &ht LEFT_SHIFT F  &kp G          &kp H        &ht RIGHT_SHIFT J  &ht LCTRL K  &ht RIGHT_ALT L  &ht COLON SEMICOLON
&ht LEFT_CONTROL ESC  &kp Z       &kp X           &kp C         &kp V             &kp B          &kp B        &kp N              &kp M        &kp COMMA        &kp PERIOD           &kp SLASH
                                                  &ht F2 SPACE  &lt 3 BACKSPACE   &lt 2 ENTER    &lt 3 SPACE  &lt 1 KP_ENTER     &kp DEL
            >;
        };

        direc {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q    |  W      |  E      |  R      |  T  |   |  Y  |  U      |  I      |  O      |  P      | BKSP |
            // | CTRL | gui(A)|  sft(S) |  ctl(D) |  alt(F) |  G  |   |  H  |  alt(J) |  ctl(K) |  sft(L) |  gui(;) |  '   |
            // | SHFT |  Z    |  X      |  C      |  V      |  B  |   |  N  |  M      |  ,      |  .      |  /      | ESC  |
            //                          | GUI     | LWR     | SPC |   | ENT | RSE     | ALT     |

            bindings = <
       &kp F1  &kp F2  &kp F3    &kp F4   &kp F5       &kp Y      &kp INSERT  &kp UP_ARROW  &kp DEL    &kp HOME
       &kp F6  &kp F7  &kp F8    &kp F9   &kp F10      &kp H      &kt LEFT    &kt DOWN      &kp RIGHT  &kp END
&kp Z  &kp Z   &kp X   &kp C     &kp V    &kp B        &kp N      &kp M       &kp COMMA     &kp DOT    &kp PAGE_DOWN  &kp PAGE_UP
                       &kp BKSP  &mo NUM  &kp ENTER    &kp SPACE  &mo NAV     &kp DEL
            >;
        };

        number {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  `  |     |  up |     |     |   |     |        | PGUP   | RALT  |     | BKSP |
            // | BTCLR| TAB | left| down|right|     |   |     |LA(HOME)|LC(PGDN)|LS(END)|     |      |
            // | SHFT | ESC |MTGAP|QWERT|     |     |   |     |G(left) |G(UP)   |G(RIGH)|CAPS |      |
            //                    |     |     |     |   |     |        |        |

            bindings = <
       &kp LC(NUMBER_1)  &kp LC(NUMBER_2)  &kp LC(NUMBER_3)  &kp LC(NUMBER_4)  &kp LC(N5)    &kp EQUAL     &kp N7        &kp N8        &kp N9        &kp PLUS
       &kp TAB           &kp LC(W)         &kp DOWN          &kp RIGHT         &trans        &kp EQUAL     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS
&kp Z  &kp ESC           &to MTGAP         &to QWERTY        &trans            &trans        &kp CAPSLOCK  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ASTERISK  &kp SLASH
                                           &trans            &trans            &trans        &trans        &trans        &kp N0
            >;
        };

        number_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  +  |  -  |  *  |  /  |  %  |   |  \  |  (  |  )  |  [  |  ]  | BKSP |
            // | CTRL |LG(1)|LS(2)|LC(3)|LA(4)|  5  |   |  6  |LA(7)|LC(8)|LS(9)|LG(0)|  `   |
            // | SHFT |  !  |  ~  |  ;  |  &  |  '  |   |  =  |  <  |  >  |  {  |  }  |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
              &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp SLASH    &kp PRCNT    &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
              &ht LGUI N1      &ht LSHFT N2  &ht LCTRL N3  &ht LALT N4  &kp N5       &kp N6     &ht LALT N7    &ht LCTRL N8  &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&bt BT_SEL 0  &bt BT_SEL 1     &kp TILDE     &kp SEMI      &kp AMPS     &kp SQT      &kp EQUAL  &kp LT         &kp GT        &kp LBRC              &kp RBRC               &bt BT_SEL 1
                                             &trans        &trans       &trans       &trans     &trans         &trans
            >;
        };

        function_layer {
            // -----------------------------------------------------------------------------------------
            // |      | BT1 | BT2 | BT3 |     |MSCDN|   |     |mkpL |mmvUP|mkpR | F12 |      |
            // |      |BTCLR|     |VOLDN|VOLUP|MSCUP|   |A(F4)|mmvLE|mmvDN|mmvRI| F11 |      |
            // |      | F1  | F2  | F3  | F4  | F5  |   | F6  | F7  | F8  | F9  | F10 |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans        &msc SCRL_UP      &trans      &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &kp F12
       &bt BT_CLR    &trans        &kp C_VOL_DN  &kp C_VOL_UP  &msc SCRL_DOWN    &kp LA(F4)  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp F11
&kp Z  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5            &kp F6      &kp F7          &kp F8          &kp F9           &kp F10  &kp ESC
                                   &trans        &trans        &trans            &trans      &trans          &trans
            >;
        };
    };
};
